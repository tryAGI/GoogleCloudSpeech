<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <CLSCompliant>false</CLSCompliant>
    <NoWarn>$(NoWarn);MEAI001;CS1591</NoWarn>
    <!-- The official Google transport currently depends on assemblies that produce ILLink warnings. -->
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>

  <PropertyGroup Label="Nuget">
    <Description>Microsoft.Extensions.AI adapter for the official Google Cloud Speech-to-Text V2 .NET SDK.</Description>
    <PackageTags>google-cloud;speech-to-text;stt;transcription;streaming;chirp;meai;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Cloud.Speech.V2" Version="1.8.0" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.0" />
  </ItemGroup>

</Project>
